  "components": {
    "schemas": {
      "CreateScheduleRequest": {
        "required": [
          "busId",
          "departureTime",
          "routeId",
          "shift"
        ],
        "type": "object",
        "properties": {
          "routeId": {
            "type": "string",
            "format": "uuid"
          },
          "busId": {
            "type": "string",
            "format": "uuid"
          },
          "shift": {
            "$ref": "#/components/schemas/Shift"
          },
          "departureTime": {
            "type": "string",
            "format": "date-span"
          },
          "basePrice": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "FareMultiplierDto": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/FareRuleType"
          },
          "multiplier": {
            "type": "number",
            "format": "double"
          },
          "condition": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FareQuoteDto": {
        "type": "object",
        "properties": {
          "basePrice": {
            "type": "number",
            "format": "double"
          },
          "appliedMultipliers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FareMultiplierDto"
            },
            "nullable": true
          },
          "finalPrice": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "FareRuleType": {
        "enum": [
          "Occupancy",
          "Shift",
          "Weekend",
          "Holiday"
        ],
        "type": "string"
      },
      "GenerateTripsRequest": {
        "required": [
          "fechaDesde",
          "fechaHasta"
        ],
        "type": "object",
        "properties": {
          "fechaDesde": {
            "type": "string",
            "format": "date"
          },
          "fechaHasta": {
            "type": "string",
            "format": "date"
          },
          "routeId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "GenerateTripsResultDto": {
        "type": "object",
        "properties": {
          "createdCount": {
            "type": "integer",
            "format": "int32"
          },
          "skippedCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "HoldSeatRequest": {
        "required": [
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "minLength": 1,
            "type": "string"
          },
          "minutes": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ScheduleTemplateDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "routeId": {
            "type": "string",
            "format": "uuid"
          },
          "busId": {
            "type": "string",
            "format": "uuid"
          },
          "shift": {
            "$ref": "#/components/schemas/Shift"
          },
          "departureTime": {
            "type": "string",
            "format": "date-span"
          },
          "basePrice": {
            "type": "number",
            "format": "double"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "SeatUserRequest": {
        "required": [
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Shift": {
        "enum": [
          "Morning",
          "Afternoon",
          "Night"
        ],
        "type": "string"
      },
      "TripSearchDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "templateId": {
            "type": "string",
            "format": "uuid"
          },
          "routeId": {
            "type": "string",
            "format": "uuid"
          },
          "busId": {
            "type": "string",
            "format": "uuid"
          },
          "departureAt": {
            "type": "string",
            "format": "date-time"
          },
          "shift": {
            "$ref": "#/components/schemas/Shift"
          },
          "status": {
            "$ref": "#/components/schemas/TripStatus"
          },
          "currentPrice": {
            "type": "number",
            "format": "double"
          },
          "availableSeats": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "TripSeatDto": {
        "type": "object",
        "properties": {
          "seatNumber": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/TripSeatStatus"
          }
        },
        "additionalProperties": false
      },
      "TripSeatStatus": {
        "enum": [
          "Available",
          "Held",
          "Sold"
        ],
        "type": "string"
      },
      "TripStatus": {
        "enum": [
          "Scheduled",
          "Departed",
          "Cancelled",
          "Completed"
        ],
        "type": "string"
      },
      "UpdateScheduleRequest": {
        "required": [
          "busId",
          "departureTime",
          "routeId",
          "shift"
        ],
        "type": "object",
        "properties": {
          "routeId": {
            "type": "string",
            "format": "uuid"
          },
          "busId": {
            "type": "string",
            "format": "uuid"
          },
          "shift": {
            "$ref": "#/components/schemas/Shift"
          },
          "departureTime": {
            "type": "string",
            "format": "date-span"
          },
          "basePrice": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Dev"
    },
    {
      "name": "Schedules"
    },
    {
      "name": "Trips"
    }
  ]
